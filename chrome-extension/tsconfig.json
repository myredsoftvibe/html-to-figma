{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "..",
    "outDir": "dist/js",
    "sourceMap": true,
    "strict": true,
    "jsx": "react",
    "lib": ["es2015", "dom"],
    "experimentalDecorators": true,
    "typeRoots": ["node_modules/@types"],
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@builder.io/html-to-figma": ["../lib/html-to-figma/index.ts"]
    }
  },
  "include": ["src", "../lib"]
}
